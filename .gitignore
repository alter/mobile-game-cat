tmp/
bin/
obj/
TestResults/
*.user
__pycache__/
*.pyc
.venv/
.hermes/
game/Assets/Levels/pool/
tools/artgen/out/
tools/coat-split/out/
# swiftc output; the source is versioned, the binary is rebuilt with
# swiftc -O vision-probe.swift -o vision-probe (50-photo/05-vision-plugin)
tools/vision-probe/vision-probe

# Reference photo set: images come from third-party datasets under their own
# licences, so only the manifest and the builder are versioned. Restore with
# python tools/photoset/build_reference_set.py
fixtures/reference-photos/*.jpg
# ...except the hand-shot ones: no script can rebuild them, so they are the
# only part of the set that has to live in git.
!fixtures/reference-photos/ofphoto_*.jpg
!fixtures/reference-photos/own_*.jpg

# Worker dependencies and local wrangler state
worker/node_modules/
worker/.wrangler/

# IL2CPP scratch space, written during an Android build
game/.utmp/

# Analytics keys never enter the repository. Two paths could carry them and
# both are closed here; tools/tests/test_no_secrets.py enforces it regardless,
# because a gitignore rule only helps for files nobody has added yet.
#
# 1. The out-of-band file the game reads them from, beside the save.
analytics-keys.txt
# 2. The GameAnalytics SDK's own settings asset. Its `SettingsGA` getter
#    creates Assets/Resources/GameAnalytics/Settings.asset the first time
#    anything touches it inside the Editor, it holds gameKey/secretKey as
#    serialized fields, and the SDK ships an Inspector tab inviting a person
#    to type keys straight into it.
game/Assets/Resources/GameAnalytics/
game/Assets/Resources/GameAnalytics.meta

# Шубы, построенные BakeTraitSet по снимкам из fixtures/reference-photos.
# Это отчёт, а не содержимое игры: пересобираются одной командой, и держать
# 3 МБ выходных картинок в истории незачем. Показания, из которых они
# строятся, в tools/traits/reference-readings.json — вот они версионируются.
tools/traits/out/
