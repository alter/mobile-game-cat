<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet test runner for Core, outside the Unity project. Unity owns
       Assets/; this compiles the same sources with NuGet NUnit so tests run
       in CI and locally without launching the editor. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9</LangVersion>
    <!-- Only .NET 10 runtime is installed on the dev machine; roll forward
         instead of requiring DOTNET_ROLL_FORWARD by hand (reviews note). -->
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../game/Assets/Core/**/*.cs" />
    <Compile Include="../../game/Assets/Tests/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
