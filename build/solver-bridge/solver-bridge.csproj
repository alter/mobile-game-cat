<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Only .NET 10 runtime is installed on the dev machine; roll forward
         instead of requiring DOTNET_ROLL_FORWARD by hand (review blocker). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <AssemblyName>solver-bridge</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../game/Assets/Core/**/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
