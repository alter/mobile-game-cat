/* Debug view styling — task 20-rules-core/06.
   Palette taken from build/playtest/index.html so the Unity build and the
   HTML prototype look the same; the same codes are listed in art-prompts.md
   section 1. Layout lives here, not inline: knowledge/unity/03-ui-toolkit-runtime.md
   recommends class-based styling. The one exception is per-tile background
   colour, which DebugGameView computes from the kind id at runtime. */

.game__root {
    flex-grow: 1;
    background-color: #F4EAD8;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 12px;
    padding-right: 12px;
    align-items: center;
}

.game__title {
    font-size: 20px;
    color: #4A3B28;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.game__status {
    font-size: 14px;
    color: #6B6055;
    margin-bottom: 12px;
}

/* The pile: tiles wrap into rows, newest additions flow left to right. */
.game__pile {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    flex-grow: 1;
    max-width: 360px;
}

/* The shelf sits at the bottom, one row, never wraps.
   Sized to fit: nine slots at 44px plus their margins came to about 502
   units against a 390-unit panel (Shell/PanelSettings.asset), so the two end
   slots were cut off the screen — visible in every iOS screenshot until
   2026-08-27. The slot is 32 wide now, and shrinks further rather than
   overflowing on a narrower phone. */
.game__shelf {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #E8D9BD;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 12px;
}

.game__slot {
    width: 32px;
    height: 32px;
    /* Unity defaults flex-shrink to 0, unlike the web: without this the row
       overflows the screen instead of giving way. */
    flex-shrink: 1;
    min-width: 0;
    margin-left: 2px;
    margin-right: 2px;
    background-color: #F4EAD8;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: #C9A97C;
    border-right-color: #C9A97C;
    border-top-color: #C9A97C;
    border-bottom-color: #C9A97C;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    align-items: center;
    justify-content: center;
}

.game__tile {
    width: 52px;
    height: 52px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: #C9A97C;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    align-items: center;
    justify-content: center;
}

/* D3: a buried item hides its kind. Blank tile, not a faded one —
   the player must not be able to read what is underneath. */
.game__tile--hidden {
    background-color: #B0A79B;
}

/* Reachable but not takeable: dimmed, still readable. */
.game__tile--dim {
    opacity: 0.45;
}

.game__tile-label {
    font-size: 18px;
    color: #4A3B28;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Overlay is present in the tree from the start and hidden by default,
   so showing it is a class toggle rather than a rebuild. */
.game__overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(74, 59, 40, 0.55);
    align-items: center;
    justify-content: center;
}

.game__overlay--shown {
    display: flex;
}

.game__card {
    background-color: #F4EAD8;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    align-items: center;
    min-width: 260px;
}

.game__card-title {
    font-size: 22px;
    color: #4A3B28;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.game__card-body {
    font-size: 15px;
    color: #6B6055;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    max-width: 240px;
}

.game__card-button {
    font-size: 16px;
    color: #4A3B28;
    background-color: #C9A97C;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    min-width: 200px;
}

/* The lock badge sits in the lower-right corner of its tile, over the prop
   and clear of most of it. Not stretched across the tile: prop_locked is a
   coil of rope drawn on its own, so at full size it replaces the prop
   instead of marking it, and the player loses the one thing the lock is
   supposed to tell them — which kind is withheld (D15, task 40-art/02). */
.game__tile-lock {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 26px;
    height: 26px;
}
